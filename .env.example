DATABASE_URL=postgres://archive:archive@localhost:5433/archive?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=archive-local
AWS_SECRET_ACCESS_KEY=archive-local-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sensor-archive
# When using a custom S3_ENDPOINT (RustFS/MinIO), set AWS_REGION to match your bucket's region
# or leave unset to let the SDK resolve it from the endpoint.